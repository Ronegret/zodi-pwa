rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // ── Usuarios ─────────────────────────────────────────────────────────────
    // Perfil base: datos públicos del usuario + preferencias
    match /users/{userId} {
      allow read:   if isAuth(); // cualquier usuario logueado puede leer perfiles (para buscar amigos)
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ── Perfiles astrales ─────────────────────────────────────────────────────
    // Datos de onboarding + astrología generados en el onboarding
    match /astralProfiles/{userId} {
      allow read:  if isAuth();
      allow write: if isOwner(userId);
    }

    // ── Perfiles de onboarding (legacy) ───────────────────────────────────────
    match /onboardingProfiles/{userId} {
      allow read:  if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ── Lecturas / Readings ───────────────────────────────────────────────────
    match /readings/{readingId} {
      allow read:   if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ── Favoritos ─────────────────────────────────────────────────────────────
    match /favorites/{favId} {
      allow read:   if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ── Historial ─────────────────────────────────────────────────────────────
    match /history/{histId} {
      allow read:   if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
    }

    // ── Logros / Achievements ─────────────────────────────────────────────────
    match /achievements/{achId} {
      allow read:   if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
    }

    // ── Notificaciones ────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ── Gamificación (gemas, rachas) ──────────────────────────────────────────
    // Solo lectura desde cliente; escritura solo desde Admin SDK
    match /gamification/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // solo Admin SDK
    }

    // ── Subscripciones / Stripe ───────────────────────────────────────────────
    match /subscriptions/{subId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow write: if false; // solo backend/Stripe webhook
    }

    // ── Publicaciones de comunidad ────────────────────────────────────────────
    match /communityPosts/{postId} {
      allow read:           if isAuth();
      allow create:         if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.authorId == request.auth.uid;
    }

    // ── Comentarios ──────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read:           if isAuth();
      allow create:         if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.authorId == request.auth.uid;
    }

    match /dailyTopicComments/{commentId} {
      allow read:           if isAuth();
      allow create:         if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.authorId == request.auth.uid;
    }

    // ── Reacciones ────────────────────────────────────────────────────────────
    match /reactions/{reactionId} {
      allow read:           if isAuth();
      allow create:         if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete:         if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ── Amistades ─────────────────────────────────────────────────────────────
    match /friendships/{docId} {
      allow read:  if isAuth() && (
        resource.data.from == request.auth.uid ||
        resource.data.to == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.from == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.from == request.auth.uid ||
        resource.data.to == request.auth.uid
      );
      allow delete: if isAuth() && (
        resource.data.from == request.auth.uid ||
        resource.data.to == request.auth.uid
      );
    }

    // ── Mensajes de chat ──────────────────────────────────────────────────────
    match /messages/{chatId}/msgs/{msgId} {
      allow read, write: if isAuth() && chatId.matches('.*' + request.auth.uid + '.*');
    }

    match /chatMessages/{messageId} {
      allow read:   if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    match /deletedChats/{chatId} {
      allow read:           if isAuth() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuth() && request.resource.data.userId == request.auth.uid;
    }

    // ── Referidos ─────────────────────────────────────────────────────────────
    match /referrals/{refId} {
      allow read:   if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
    }

    // ── Bloqueo total para todo lo demás ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
