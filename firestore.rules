rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regla global por defecto: Denegar todo (seguridad por defecto)
    match /{document=**} {
      allow read, write: if false;
    }

    // Colección de Usuarios: Solo el propio usuario puede leer y modificar su perfil
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Colección de Comunidad (Posts)
    match /community_posts/{postId} {
      allow read: if true; // Todos pueden leer
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Colección de Comentarios (Comunidad)
    match /community_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }
  }
}
