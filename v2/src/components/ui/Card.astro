---
/** Panel de cristal Zodi. El título es un h2 enlazado a la región. */
interface Props {
  title: string;
  kicker?: string | undefined;
  action?: { label: string; href: string } | undefined;
  class?: string;
  id?: string;
}
const { title, kicker, action, class: className, id } = Astro.props;
const headingId = `${
  id ??
  'c-' +
    title
      .toLowerCase()
      .normalize('NFD')
      .replace(/[^\w]+/g, '-')
}-title`;
---

<section class:list={['card', className]} aria-labelledby={headingId} id={id}>
  <header class="card-header">
    <div class="card-heading">
      {kicker && <p class="kicker">{kicker}</p>}
      <h2 id={headingId} class="card-title">
        {title}
      </h2>
    </div>
    {action && (
      <a class="card-action" href={action.href}>
        {action.label}
      </a>
    )}
  </header>
  <slot />
</section>
