---
/**
 * Vídeo de ambiente de ZODI: mudo, en bucle y decorativo. Con movimiento
 * reducido no arranca (se queda el póster); fuera de pantalla se pausa; y
 * siempre hay un botón para pararlo (WCAG 2.2.2).
 */
interface Props {
  /** Ruta sin extensión: /video/zodi-portada → .mp4 y .webp (póster). */
  src: string;
  width: number;
  height: number;
  class?: string;
}

const { src, width, height, class: className } = Astro.props;
---

<div class:list={['ambient', className]} data-ambient>
  <video
    muted
    loop
    playsinline
    preload="none"
    poster={`${src}.webp`}
    width={width}
    height={height}
    aria-hidden="true"
    tabindex="-1"
    disablepictureinpicture
  >
    <source src={`${src}.mp4`} type="video/mp4" />
  </video>
  <button type="button" class="ambient-toggle js-only" aria-pressed="false">
    <span class="visually-hidden">Pausar vídeo</span>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path class="i-pause" d="M8 5v14M16 5v14"></path>
      <path class="i-play" d="M7 5l12 7-12 7z"></path>
    </svg>
  </button>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const box of document.querySelectorAll<HTMLElement>('[data-ambient]')) {
    const video = box.querySelector('video')!;
    const toggle = box.querySelector<HTMLButtonElement>('.ambient-toggle')!;
    let paused = reduce.matches;
    let visible = false;

    const sync = () => {
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.querySelector('.visually-hidden')!.textContent = paused
        ? 'Reproducir vídeo'
        : 'Pausar vídeo';
      if (!paused && visible) {
        if (video.preload === 'none') video.preload = 'auto';
        void video.play().catch(() => undefined);
      } else video.pause();
    };

    toggle.addEventListener('click', () => {
      paused = !paused;
      sync();
    });
    new IntersectionObserver(([entry]) => {
      visible = entry!.isIntersecting;
      sync();
    }).observe(box);
    sync();
  }
</script>

<style>
  .ambient {
    position: relative;
    overflow: hidden;
  }
  .ambient video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .ambient-toggle {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    z-index: 2;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgb(6 6 8 / 70%);
    color: var(--ink);
    cursor: pointer;
  }
  .ambient-toggle:hover {
    border-color: var(--acid);
    color: var(--acid);
  }
  .ambient-toggle svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ambient-toggle[aria-pressed='false'] .i-play,
  .ambient-toggle[aria-pressed='true'] .i-pause {
    display: none;
  }
</style>
