---
/**
 * El cielo sobre tu lugar de nacimiento en el instante en que naciste, como
 * se ve tumbado mirando arriba: el centro es el cénit, el borde el
 * horizonte, el norte arriba y el este a la izquierda. Solo SVG.
 */
import { PLANET_GLYPHS } from '@/lib/astro-engine/labels';
import type { SkyBody } from '@/lib/chart/birth-day';

interface Props {
  sky: SkyBody[];
  isDay: boolean | null;
  place: string;
  /** Semilla para las estrellas de fondo (siempre las mismas para cada persona). */
  seed: string;
}
const { sky, isDay, place, seed } = Astro.props;

const C = 160;
const R = 138;
const pos = (alt: number, az: number) => {
  const r = ((90 - alt) / 90) * R;
  const a = (az * Math.PI) / 180;
  return { x: C - r * Math.sin(a), y: C - r * Math.cos(a) };
};

// Estrellas decorativas deterministas.
let h = 2166136261;
for (const ch of seed) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
const rand = () => {
  h = Math.imul(h ^ (h >>> 15), 2246822507);
  h = Math.imul(h ^ (h >>> 13), 3266489909);
  return ((h ^= h >>> 16) >>> 0) / 4294967296;
};
const stars = Array.from({ length: 90 }, (_, i) => {
  const r = Math.sqrt(rand()) * (R - 4);
  const a = rand() * Math.PI * 2;
  return {
    x: C + r * Math.cos(a),
    y: C + r * Math.sin(a),
    s: 0.4 + rand() * 1.1,
    d: i % 3,
  };
});

const above = sky.filter((b) => b.above);

// Cada etiqueta prueba posiciones alrededor de su planeta (derecha, izquierda,
// arriba, abajo) hasta no chocar con otra; si se aleja, una línea la une.
type Box = { x0: number; x1: number; y0: number; y1: number };
const placed: Box[] = [];
const hit = (a: Box) =>
  a.x0 < 4 ||
  a.x1 > 316 ||
  a.y0 < 12 ||
  a.y1 > 316 ||
  placed.some((b) => a.x0 < b.x1 && a.x1 > b.x0 && a.y0 < b.y1 && a.y1 > b.y0);
const marks = above
  .map((b) => ({ b, ...pos(b.altitude, b.azimuth), big: b.id === 'sun' || b.id === 'moon' }))
  .sort((m1, m2) => m1.y - m2.y)
  .map((m) => {
    const w = m.b.name.length * 6 + 16;
    const off = m.big ? 12 : 8;
    const sides = m.x > 215 ? ['end', 'start'] : ['start', 'end'];
    let best = { lx: m.x + off, ly: m.y + 4, anchor: 'start' };
    search: for (const dy of [0, -12, 12, -24, 24, -36, 36, -48, 48]) {
      for (const side of sides) {
        const lx = side === 'start' ? m.x + off : m.x - off;
        const ly = m.y + 4 + dy;
        const box = {
          x0: side === 'start' ? lx : lx - w,
          x1: side === 'start' ? lx + w : lx,
          y0: ly - 10,
          y1: ly + 3,
        };
        if (!hit(box)) {
          placed.push(box);
          best = { lx, ly, anchor: side };
          break search;
        }
      }
    }
    return { ...m, ...best, leader: Math.abs(best.ly - (m.y + 4)) > 6 };
  });
const below = sky.filter((b) => !b.above && b.nakedEye);
const COLOR: Record<string, string> = {
  sun: '#ffd84d',
  moon: '#f4f1ff',
  mercury: '#b8ff17',
  venus: '#ff8ad8',
  mars: '#ff5a4d',
  jupiter: '#ffb44d',
  saturn: '#d9c48a',
  uranus: '#7df9ff',
  neptune: '#6aa8ff',
  pluto: '#b48cff',
};
const list = (xs: SkyBody[]) => xs.map((b) => b.name).join(', ');
const desc = above.length
  ? `Sobre el horizonte de ${place}: ${list(above)}.`
  : `Ningún planeta estaba sobre el horizonte de ${place}.`;
---

<figure class="birth-sky">
  <svg viewBox="0 0 320 320" role="img" aria-labelledby="sky-t sky-d">
    <title id="sky-t">El cielo sobre {place} cuando naciste</title>
    <desc id="sky-d">{desc}</desc>
    <defs>
      <radialGradient id="sky-night" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#2a1550" />
        <stop offset="70%" stop-color="#120a26" />
        <stop offset="100%" stop-color="#05040b" />
      </radialGradient>
      <radialGradient id="sky-day" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#4b5fd6" />
        <stop offset="75%" stop-color="#2a2a7a" />
        <stop offset="100%" stop-color="#0d0b24" />
      </radialGradient>
      <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="b" />
        <feMerge>
          <feMergeNode in="b" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>
    <circle cx={C} cy={C} r={R} fill={isDay ? 'url(#sky-day)' : 'url(#sky-night)'} />
    {stars.map((s) => (
      <circle
        class={`star d${s.d}`}
        cx={s.x.toFixed(1)}
        cy={s.y.toFixed(1)}
        r={s.s.toFixed(2)}
        fill="#fff"
        opacity={isDay ? 0.18 : 0.7}
      />
    ))}
    <circle cx={C} cy={C} r={(R * 2) / 3} fill="none" stroke="#ffffff22" stroke-dasharray="2 4" />
    <circle cx={C} cy={C} r={R / 3} fill="none" stroke="#ffffff22" stroke-dasharray="2 4" />
    <circle cx={C} cy={C} r={R} fill="none" stroke="#b8ff17" stroke-width="1.5" />
    <text x={C} y="14" class="card-pt">
      N
    </text>
    <text x={C} y="314" class="card-pt">
      S
    </text>
    <text x="8" y={C + 4} class="card-pt">
      E
    </text>
    <text x="312" y={C + 4} class="card-pt">
      O
    </text>
    {marks.map((m) => (
      <g class="body" filter="url(#glow)">
        {m.leader && (
          <line
            x1={m.x.toFixed(1)}
            y1={m.y.toFixed(1)}
            x2={m.lx.toFixed(1)}
            y2={(m.ly - 4).toFixed(1)}
            stroke={COLOR[m.b.id]}
            stroke-width="0.8"
            opacity="0.7"
          />
        )}
        <circle cx={m.x.toFixed(1)} cy={m.y.toFixed(1)} r={m.big ? 9 : 5} fill={COLOR[m.b.id]} />
        <text
          x={m.lx.toFixed(1)}
          y={m.ly.toFixed(1)}
          text-anchor={m.anchor}
          class="label"
          fill={COLOR[m.b.id]}
        >
          {PLANET_GLYPHS[m.b.id]} {m.b.name}
        </text>
      </g>
    ))}
  </svg>
  <figcaption>
    <span>{desc}</span>
    {below.length > 0 && <span class="muted"> Bajo el horizonte: {list(below)}.</span>}
  </figcaption>
</figure>

<style>
  .birth-sky {
    margin: 0;
    display: grid;
    gap: var(--space-2);
    justify-items: center;
  }
  .birth-sky svg {
    width: 100%;
    max-width: 22rem;
    height: auto;
    filter: drop-shadow(0 0 30px rgb(155 77 255 / 35%));
  }
  .card-pt {
    fill: #b8ff17;
    font: 700 12px var(--font-mono, monospace);
    text-anchor: middle;
  }
  .label {
    font: 600 10px var(--font-body, sans-serif);
  }
  figcaption {
    font-size: var(--step--1);
    text-align: center;
    max-width: 22rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .star {
      animation: twinkle 3.2s ease-in-out infinite;
    }
    .star.d1 {
      animation-delay: 1.1s;
    }
    .star.d2 {
      animation-delay: 2.2s;
    }
  }
  @keyframes twinkle {
    50% {
      opacity: 0.15;
    }
  }
</style>
