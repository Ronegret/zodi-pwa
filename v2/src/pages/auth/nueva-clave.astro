---
import AuthLayout from '@/layouts/AuthLayout.astro';
import ErrorSummary from '@/components/ui/ErrorSummary.astro';
import Field from '@/components/ui/Field.astro';
import { AUTH_UNAVAILABLE, authErrorMessage } from '@/lib/auth/errors';
import { newPasswordSchema } from '@/lib/validation/auth';
import { fieldErrors, formToObject } from '@/lib/validation/common';

// El middleware garantiza sesión (la crea el enlace de recuperación).
let errors: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const parsed = newPasswordSchema.safeParse(formToObject(form));
  if (!parsed.success) {
    errors = fieldErrors(parsed.error);
    Astro.response.status = 422;
  } else if (!Astro.locals.supabase) {
    errors = { _form: AUTH_UNAVAILABLE };
    Astro.response.status = 503;
  } else {
    const { error } = await Astro.locals.supabase.auth.updateUser({
      password: parsed.data.password,
    });
    // Desde Ajustes se vuelve a Ajustes; desde el correo de recuperación, al panel.
    if (!error) {
      const fromSettings = Astro.url.searchParams.get('desde') === 'ajustes';
      return Astro.redirect(fromSettings ? '/app/ajustes?clave=1' : '/app', 303);
    }
    errors = { _form: authErrorMessage(error) };
    Astro.response.status = 400;
  }
}
---

<AuthLayout
  title="Nueva contraseña"
  intro="Elige una que no sea tu fecha de nacimiento. Ya la sabemos."
>
  <ErrorSummary errors={errors} />
  <form method="post" novalidate class="stack" data-validate>
    <Field
      name="password"
      label="Nueva contraseña"
      type="password"
      autocomplete="new-password"
      hint="Mínimo 10 caracteres, con al menos una letra y un número."
      required
      error={errors.password}
    />
    <Field
      name="confirm"
      label="Repite la contraseña"
      type="password"
      autocomplete="new-password"
      required
      error={errors.confirm}
    />
    <button class="btn btn-block" type="submit">
      Guardar contraseña
    </button>
  </form>
</AuthLayout>

<script>
  import { enhanceForm } from '@/lib/forms/enhance';
  import { newPasswordSchema } from '@/lib/validation/auth';

  enhanceForm(document.querySelector<HTMLFormElement>('form[data-validate]'), newPasswordSchema);
</script>
