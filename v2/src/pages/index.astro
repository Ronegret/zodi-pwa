---
/** Portada con el estilo Zodi y el anillo zodiacal 3D (la imagen es su alternativa). */
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
import LegalLinks from '@/components/LegalLinks.astro';
import { HeroZodiac } from '@/components/scenes/HeroZodiac';
---

<Base title="El universo tiene mensajes para ti">
  <header class="top">
    <img src="/brand/logo-240.webp" alt="ZODI" width="240" height="160" class="logo" />
    <nav aria-label="Cuenta" class="top-actions">
      <Button href="/auth/login" variant="ghost" size="sm">
        Entrar
      </Button>
      <Button href="/auth/registro" size="sm">
        Crear cuenta
      </Button>
    </nav>
  </header>
  <main id="main" class="hero" data-cursor-glow>
    <div class="copy">
      <p class="kicker">Ecosistema astrológico cyberpunk</p>
      <h1>
        El universo tiene mensajes <span class="graffiti">para ti.</span>
      </h1>
      <p class="lead">
        Zodi reúne carta natal real, horóscopo, tarot, numerología, compatibilidad y comunidad. Sin
        humo: efemérides de verdad y una IA que no se muerde la lengua.
      </p>
      <div class="cta">
        <Button href="/auth/registro" icon="sparkles" magnetic>
          Empezar gratis
        </Button>
        <Button href="/auth/login" variant="secondary" magnetic>
          Ya tengo cuenta
        </Button>
      </div>
    </div>
    <section class="stage" aria-label="Los doce signos">
      <HeroZodiac client:load>
        <img
          class="character"
          src="/brand/zodi-480.webp"
          alt="Zodi, la mascota, rodeada de luces de neón"
          width="480"
          height="720"
        />
      </HeroZodiac>
    </section>
  </main>
  <footer class="foot">
    <LegalLinks />
  </footer>
</Base>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) clamp(1rem, 4vw, 3rem);
  }
  .logo {
    width: 110px;
    height: auto;
    filter: drop-shadow(0 0 16px rgb(184 255 23 / 25%));
  }
  .top-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  @media (max-width: 380px) {
    .logo {
      width: 84px;
    }
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
    max-width: 76rem;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 4vw, 3rem) var(--space-8);
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }
  }
  .copy {
    display: grid;
    gap: var(--space-5);
  }
  /* Sin guiones: "universo" y "mensajes" caben enteras en la columna. */
  h1 {
    font-size: clamp(2.3rem, 1.1rem + 4.4vw, 5rem);
    max-width: 12ch;
    hyphens: manual;
  }
  @media (min-width: 960px) {
    h1 {
      font-size: clamp(3rem, 0.6rem + 3.9vw, 4.75rem);
    }
  }
  .lead {
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: var(--step-1);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .stage {
    width: min(100%, 34rem);
    justify-self: center;
  }
  .foot {
    padding: 0 var(--space-4) var(--space-6);
  }
  .character {
    filter: drop-shadow(0 0 40px rgb(155 77 255 / 35%));
  }
</style>
