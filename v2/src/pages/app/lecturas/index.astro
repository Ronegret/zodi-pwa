---
import AppShell from '@/layouts/AppShell.astro';
import Badge from '@/components/ui/Badge.astro';
import Icon from '@/components/ui/Icon.astro';
import { GROUPS, KINDS, KIND_BY_KIND } from '@/lib/ai/kinds';
import { getQuotaStatus } from '@/lib/server/quota';
import { listReadings } from '@/lib/server/readings';
import { excerpt, readingDate } from '@/lib/readings/format';

const { supabase, profile } = Astro.locals;
if (!supabase || !profile) return Astro.redirect('/auth/login', 303);

const [quota, recent] = await Promise.all([getQuotaStatus(supabase), listReadings(supabase, 6)]);
const remaining = quota ? Math.max(0, quota.limit - quota.used) : null;
const [featured, ...rest] = KINDS;
const tz = profile.time_zone ?? 'Europe/Madrid';
---

<AppShell
  title="Lecturas"
  current="lecturas"
  kicker="Oráculo personal"
  intro="Cada lectura usa tu carta real y el cielo de hoy. Nada de horóscopos de sala de espera."
>
  <div class="hub">
    <p class="quota">
      <Icon name="bolt" size={18} />
      {remaining === null ? (
        'Lecturas del día'
      ) : (
        <span>
          Te quedan <strong>{remaining}</strong> de {quota!.limit} lecturas hoy
        </span>
      )}
      <Badge tone="acid">
        {({ free: 'Free', premium: 'Premium', vip: 'VIP' } as const)[profile.plan]}
      </Badge>
    </p>

    <a class="featured reveal" href={`/app/lecturas/${featured!.slug}`}>
      <img
        src="/art/zodi-leyendo-1024.webp"
        srcset="/art/zodi-leyendo-640.webp 640w, /art/zodi-leyendo-1024.webp 1024w"
        sizes="(min-width: 1100px) 50vw, 100vw"
        alt="ZODI leyendo el destino con sus cartas y su gato"
        width="1024"
        height="683"
        loading="eager"
      />
      <div class="featured-text">
        <p class="kicker">{featured!.kicker}</p>
        <h2>{featured!.title}</h2>
        <p>{featured!.blurb}</p>
        <span class="btn btn-primary">
          <Icon name="sparkles" />
          <span class="btn-label">{featured!.cta}</span>
        </span>
      </div>
    </a>

    {GROUPS.map((g) => (
      <section class="group" aria-labelledby={`grupo-${g.id}`}>
        <div class="group-head">
          <h2 id={`grupo-${g.id}`} class="section-title">
            {g.title}
          </h2>
          <p class="muted">{g.blurb}</p>
        </div>
        <ul class="kinds">
          {g.id === 'tarot' && (
            <li>
              <a class="kind reveal" href="/app/oraculo">
                <img
                  src="/art/zodi-bola-640.webp"
                  alt=""
                  width="640"
                  height="640"
                  loading="lazy"
                  decoding="async"
                />
                <span class="kind-text">
                  <span class="kicker">Consulta libre</span>
                  <span class="kind-title">Oráculo de ZODI</span>
                  <span class="kind-blurb">
                    Pregunta lo que te pese y ZODI te contesta en directo, con tu carta delante.
                  </span>
                </span>
                <span class="kind-go" aria-hidden="true">
                  <Icon name="chevronRight" />
                </span>
              </a>
            </li>
          )}
          {rest
            .filter((k) => k.group === g.id)
            .map((k) => (
              <li>
                <a class="kind reveal" href={`/app/lecturas/${k.slug}`}>
                  <img
                    src={k.art}
                    alt=""
                    width="640"
                    height="640"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="kind-text">
                    <span class="kicker">{k.kicker}</span>
                    <span class="kind-title">{k.title}</span>
                    <span class="kind-blurb">{k.blurb}</span>
                  </span>
                  <span class="kind-go" aria-hidden="true">
                    <Icon name="chevronRight" />
                  </span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))}

    <section class="recent" aria-labelledby="recent-title">
      <h2 id="recent-title" class="section-title">
        <Icon name="history" /> Tus últimas lecturas
      </h2>
      {recent.length ? (
        <ul class="recent-list">
          {recent.map((r) => (
            <li>
              <a href={`/app/lecturas/guardadas/${r.id}`}>
                <span class="recent-head">
                  <strong>{KIND_BY_KIND.get(r.kind)?.title ?? 'Lectura'}</strong>
                  <span class="muted small">{readingDate(r.created_at, tz)}</span>
                </span>
                <span class="muted">{excerpt(r.content, 140)}</span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">
          Aún no tienes lecturas. El universo está esperando a que preguntes algo.
        </p>
      )}
      <p class="all">
        <a href="/app/lecturas/historial">Ver todo el historial</a> ·{' '}
        <a href="/app/lecturas/historial?favoritas=1">Tus favoritas</a>
      </p>
    </section>
  </div>
</AppShell>

<style>
  .hub {
    display: grid;
    gap: var(--space-6);
  }
  .quota {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--line-acid);
    background: rgb(184 255 23 / 6%);
    color: var(--ink-soft);
  }
  .quota :global(svg) {
    color: var(--acid);
  }
  .quota strong {
    color: var(--acid);
  }
  /* Ilustración de ZODI entera a un lado y el texto al otro: nada tapa al personaje. */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--line-acid);
    background: var(--panel);
    box-shadow: var(--shadow-lg), var(--glow-acid);
    color: var(--ink);
    text-decoration: none;
  }
  @media (min-width: 900px) {
    .featured {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .featured img {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    display: block;
  }
  .featured-text {
    display: grid;
    gap: var(--space-3);
    align-content: center;
    justify-items: start;
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }
  .featured h2 {
    font-size: clamp(1.9rem, 1.1rem + 2vw, 2.7rem);
    hyphens: manual;
    overflow-wrap: normal;
  }
  .featured p:not(.kicker) {
    color: var(--ink-soft);
    font-size: var(--step-1);
  }
  .group {
    display: grid;
    gap: var(--space-4);
  }
  .group-head {
    display: grid;
    gap: var(--space-1);
  }
  .group-head p {
    margin: 0;
  }
  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--step-2);
  }
  .kinds {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  /* La ilustración de cada sección se ve entera (son carteles con texto). */
  .kind {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .kind img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
  }
  .kind:hover {
    border-color: var(--acid);
    box-shadow: var(--glow-acid);
    transform: translateY(-2px);
  }
  .kind-text {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  /* Sin guiones y con tamaño que cabe ("Compatibilidad" en una tarjeta estrecha). */
  .kind-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.15;
    hyphens: manual;
  }
  .kind-blurb {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .kind-go {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(6 6 8 / 70%);
    color: var(--acid);
  }
  .recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .recent-list a {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 3%);
    color: var(--ink);
    text-decoration: none;
  }
  .recent-list a:hover {
    border-color: var(--acid);
  }
  .recent-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .small {
    font-size: var(--step--1);
  }
  .all {
    margin-top: var(--space-3);
  }
  .all a {
    color: var(--acid);
  }
  @media (prefers-reduced-motion: reduce) {
    .kind:hover {
      transform: none;
    }
  }
</style>
