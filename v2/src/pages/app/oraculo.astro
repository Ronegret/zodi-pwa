---
import AppShell from '@/layouts/AppShell.astro';
import ReadingGuide from '@/components/readings/ReadingGuide.astro';
import Button from '@/components/ui/Button.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { AssistantChat } from '@/components/readings/AssistantChat';
import { aiAvailable } from '@/lib/ai/client';
import { GUIDES } from '@/lib/ai/guides';
import { TONES } from '@/lib/onboarding/steps';
import { getLatestSelfChart } from '@/lib/server/charts';
import { getOracleQuota } from '@/lib/server/quota';

const { supabase, profile } = Astro.locals;
if (!supabase || !profile) return Astro.redirect('/auth/login', 303);

const [quota, stored] = await Promise.all([getOracleQuota(supabase), getLatestSelfChart(supabase)]);
const remaining = quota ? Math.max(0, quota.limit - quota.used) : null;
const firstName = profile.display_name.trim().split(/\s+/)[0] || 'tú';
const planet = (id: string) => stored?.chart.planets.find((p) => p.id === id)?.sign;
const bigThree =
  stored && planet('sun') && planet('moon')
    ? {
        sun: planet('sun')!,
        moon: planet('moon')!,
        ascendant: stored.input.timeKnown ? stored.chart.ascendant.sign : undefined,
      }
    : undefined;
---

<AppShell
  title="El oráculo de ZODI"
  current="oraculo"
  kicker="Oráculo personal"
  intro="Pregunta lo que te pese. ZODI tiene tu carta abierta y el cielo de hoy delante, y no te va a dar la razón por darte la razón."
>
  {aiAvailable() ? (
    <AssistantChat
      client:load
      firstName={firstName}
      remaining={remaining}
      bigThree={bigThree}
      toneLabel={TONES[profile.reading_tone].title}
    />
  ) : (
    <EmptyState title="El oráculo está descansando" headingLevel={2}>
      <p>
        ZODI vuelve enseguida. Mientras, tienes tu horóscopo de hoy y tu carta calculados con el
        cielo real.
      </p>
      <Button href="/app/horoscopo" icon="sun">
        Mi horóscopo de hoy
      </Button>
    </EmptyState>
  )}
  <div class="guide-wrap">
    <ReadingGuide guide={GUIDES.oraculo!} title="Para sacarle más partido" />
  </div>
</AppShell>

<style>
  .guide-wrap {
    margin-top: var(--space-7);
  }
</style>
