---
/**
 * Tu carta natal en PDF (Fase 6): una página pensada para imprimir o
 * "Guardar como PDF" desde el navegador, en A4 y con el estilo de ZODI.
 * Portada, tres pilares, la rueda, los elementos, los planetas uno a uno y
 * las casas, todo en palabras normales.
 */
import Base from '@/layouts/Base.astro';
import NatalWheel from '@/components/chart/NatalWheel.astro';
import ElementsDonut from '@/components/dashboard/ElementsDonut.astro';
import {
  elementBalance,
  formatPosition,
  PLANET_GLYPHS,
  PLANET_NAMES,
  signSlug,
  SIGN_GLYPHS,
} from '@/lib/astro-engine/labels';
import { HOUSES, PLANET_ROLE, plainPlanet } from '@/lib/chart/plain';
import { SIGN_KEYWORDS } from '@/lib/public/signs';
import { getLatestSelfChart } from '@/lib/server/charts';

const { supabase, profile } = Astro.locals;
if (!supabase || !profile) return Astro.redirect('/auth/login', 303);
const stored = await getLatestSelfChart(supabase);
if (!stored) return Astro.redirect('/app/carta', 303);

const chart = stored.chart;
const timeKnown = stored.input.timeKnown;
const sun = chart.planets.find((p) => p.id === 'sun')!;
const moon = chart.planets.find((p) => p.id === 'moon')!;
const name = profile.display_name || 'Tu carta';
const birth = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long', timeZone: 'UTC' }).format(
  new Date(`${stored.input.date}T12:00:00Z`),
);
const today = new Intl.DateTimeFormat('es-ES', { dateStyle: 'long' }).format(new Date());
const pillars = [
  { glyph: '☉', what: 'Tu esencia', label: `Sol en ${sun.sign}`, plain: SIGN_KEYWORDS[sun.sign] },
  {
    glyph: '☽',
    what: 'Tus emociones',
    label: `Luna en ${moon.sign}`,
    plain: SIGN_KEYWORDS[moon.sign],
  },
  timeKnown
    ? {
        glyph: '↑',
        what: 'Cómo te ven',
        label: `Ascendente en ${chart.ascendant.sign}`,
        plain: SIGN_KEYWORDS[chart.ascendant.sign],
      }
    : {
        glyph: '↑',
        what: 'Cómo te ven',
        label: 'Ascendente',
        plain: 'Necesita la hora de nacimiento',
      },
];
---

<Base title={`Carta natal de ${name}`} description="Tu carta natal en PDF, con el estilo de ZODI.">
  <main id="main" class="doc">
    <div class="toolbar no-print">
      <a href="/app/carta" class="btn btn-ghost">
        Volver a mi carta
      </a>
      <button type="button" class="btn btn-primary" data-print>
        Guardar como PDF
      </button>
      <p class="muted small">
        En el cuadro de impresión elige «Guardar como PDF». En el móvil: compartir → imprimir.
      </p>
    </div>

    <section class="sheet cover">
      <img class="logo" src="/brand/logo-480.webp" alt="ZODI" width="480" height="320" />
      <img
        class="cover-art"
        src={`/signos/${signSlug(sun.sign)}-1024.webp`}
        alt={`${sun.sign} según ZODI`}
        width="1024"
        height="1024"
      />
      <p class="kicker">Carta natal</p>
      <h1>{name}</h1>
      <p class="cover-data">
        {birth}
        {timeKnown ? ` · ${stored.input.time}` : ' · hora desconocida'}
        <br />
        {profile.birth_place ?? ''}
      </p>
      <ul class="pillars">
        {pillars.map((p) => (
          <li>
            <span class="pg" aria-hidden="true">
              {p.glyph}
            </span>
            <span>
              <span class="what">{p.what}</span>
              <strong>{p.label}</strong>
              <span class="plain">{p.plain}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section class="sheet">
      <h2>Tu rueda del cielo</h2>
      <p class="lead">
        El cielo exacto del momento en que naciste. El círculo son los 12 signos; cada símbolo, un
        planeta en el signo donde estaba; las líneas unen planetas que se influyen (azules: se
        llevan bien; rosas: chocan y te hacen crecer).
      </p>
      <div class="wheel">
        <NatalWheel chart={chart} timeKnown={timeKnown} id="wheel-pdf" />
      </div>
      <h2>Tus elementos</h2>
      <p class="lead">
        Fuego es acción, tierra lo práctico, aire las ideas y agua las emociones. El que más pesa
        dice mucho de cómo eres.
      </p>
      <div class="donut">
        <ElementsDonut balance={elementBalance(chart.planets)} />
      </div>
    </section>

    <section class="sheet">
      <h2>Tus planetas, uno a uno</h2>
      <p class="lead">
        Cada planeta es una parte de ti; el signo, cómo la vives; la casa, en qué área de tu vida se
        nota más.
      </p>
      <ul class="planets">
        {chart.planets.map((p) => (
          <li>
            <span class="pg" aria-hidden="true">
              {PLANET_GLYPHS[p.id]}
            </span>
            <span>
              <strong>{PLANET_NAMES[p.id]}</strong>
              <span class="what"> · {PLANET_ROLE[p.id].short}</span>
              <span class="where">
                <span aria-hidden="true">{SIGN_GLYPHS[p.sign]}</span> {formatPosition(p)}
                {timeKnown && ` · Casa ${p.house} (${HOUSES[p.house - 1]!.name})`}
                {p.retrograde && p.id !== 'northNode' && ' · retrógrado'}
              </span>
              <span class="plain">{plainPlanet(p.id, p.sign, timeKnown ? p.house : null)}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    {timeKnown && (
      <section class="sheet">
        <h2>Tus 12 casas</h2>
        <p class="lead">Las 12 áreas de tu vida y el signo con el que empieza cada una.</p>
        <ol class="houses">
          {chart.houses.map((h, i) => (
            <li>
              <strong>
                Casa {i + 1} · {HOUSES[i]!.name}
              </strong>
              <span class="plain">
                {HOUSES[i]!.area}. Empieza en {formatPosition(h)}.
              </span>
            </li>
          ))}
        </ol>
      </section>
    )}

    <p class="foot">
      Calculada por ZODI con efemérides astronómicas el {today}. Guía simbólica, no profecía: las
      decisiones las tomas tú. · zodi.aibueno.es · Creado por Rodrigo Negrete (rodrigonegrete.es)
    </p>
  </main>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .doc {
    max-width: 52rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4) var(--space-7);
    display: grid;
    gap: var(--space-6);
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }
  .sheet {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    border: 1px solid var(--line-acid);
    background: var(--panel);
  }
  .cover {
    justify-items: center;
    text-align: center;
  }
  .logo {
    width: 9rem;
    height: auto;
  }
  .cover-art {
    width: min(100%, 18rem);
    height: auto;
    border-radius: var(--radius-xl);
    border: 2px solid var(--acid);
  }
  .cover h1 {
    font-size: clamp(2.2rem, 1.5rem + 3vw, 3.4rem);
    margin: 0;
  }
  .cover-data {
    color: var(--ink-soft);
  }
  .pillars,
  .planets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    text-align: left;
    width: 100%;
  }
  .pillars {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }
  .pillars li,
  .planets li {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    break-inside: avoid;
  }
  .pillars li > span:last-child,
  .planets li > span:last-child {
    display: grid;
    gap: 2px;
  }
  .pg {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    color: var(--acid);
    background: rgb(184 255 23 / 10%);
  }
  .what {
    font-size: 0.75rem;
    color: var(--acid);
  }
  .where {
    font-weight: 700;
  }
  .plain {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .lead {
    color: var(--ink-soft);
    margin: 0;
  }
  .wheel {
    max-width: 30rem;
    margin: 0 auto;
    width: 100%;
  }
  .donut {
    max-width: 26rem;
  }
  .houses {
    margin: 0;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }
  .houses li {
    display: grid;
    gap: 2px;
    break-inside: avoid;
  }
  .foot {
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-align: center;
  }
  .small {
    font-size: var(--step--1);
  }

  /* Impresión / PDF: A4, colores de ZODI intactos y una sección por página. */
  @page {
    size: A4;
    margin: 12mm;
  }
  @media print {
    :global(html),
    :global(body) {
      background: #060608 !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    :global(.skip-link),
    .no-print {
      display: none !important;
    }
    .doc {
      padding: 0;
      max-width: none;
    }
    .sheet {
      break-after: page;
      border-color: #3a4a12;
    }
  }
</style>
