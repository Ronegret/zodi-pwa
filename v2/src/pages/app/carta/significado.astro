---
/**
 * El significado de tu carta: todo lo que se lee con tu nacimiento, escrito
 * por ZODI y en palabras normales. Cada sección trae su pregunta lista para
 * el oráculo. Sin IA: está siempre, al momento.
 */
import AppShell from '@/layouts/AppShell.astro';
import Button from '@/components/ui/Button.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Field from '@/components/ui/Field.astro';
import BirthDayPanel from '@/components/chart/BirthDayPanel.astro';
import Icon from '@/components/ui/Icon.astro';
import { todayFor } from '@/lib/ai/context';
import { birthDay } from '@/lib/chart/birth-day';
import { chartMeaning, numberImage } from '@/lib/chart/meaning';
import { NameLookup } from '@/components/names/NameLookup';
import { nameMeaning, REGISTRY_SIZE } from '@/lib/names/meaning';
import { getLatestSelfChart } from '@/lib/server/charts';

const { supabase, profile } = Astro.locals;
if (!supabase || !profile) return Astro.redirect('/auth/login', 303);

// El nombre completo (con los apellidos): se guarda para que ZODI lo recuerde.
let fullName = (profile.full_name ?? profile.display_name).trim();
let savedName = false;
if (Astro.request.method === 'POST') {
  const typed = String((await Astro.request.formData()).get('nombre') ?? '')
    .trim()
    .replace(/\s+/g, ' ')
    .slice(0, 80);
  if (typed) {
    fullName = typed;
    const { error } = await supabase
      .from('profiles')
      .update({ full_name: typed })
      .eq('id', profile.id);
    savedName = !error;
  }
}
// Con un solo nombre (sin apellidos) invitamos a completarlo.
const needsSurnames = fullName.split(/\s+/).length < 2;
const nameParts = nameMeaning(fullName);
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const fmt = (x: number) => new Intl.NumberFormat('es-ES', { useGrouping: 'always' }).format(x);

const stored = await getLatestSelfChart(supabase);
const meaning = stored
  ? chartMeaning({
      chart: stored.chart,
      timeKnown: stored.input.timeKnown,
      birthDate: stored.input.date,
      displayName: fullName,
      today: todayFor(new Date(), profile.time_zone ?? 'Europe/Madrid'),
    })
  : [];
// "Tu nombre" va justo después de los números.
const sections = meaning.flatMap((s) =>
  s.id === 'numeros'
    ? [
        s,
        {
          id: 'nombre',
          kicker: 'Tu nombre',
          title: `Lo que significa «${fullName}»`,
          image: '/art/numerologia-banner-640.webp',
          paragraphs: [],
          ask: `¿Qué significa mi nombre completo, ${fullName}, y de dónde viene cada apellido?`,
        },
      ]
    : [s],
);
const ask = (q: string) => `/app/oraculo?pregunta=${encodeURIComponent(q)}`;

// El día que naciste: el cielo sobre tu lugar, la Luna, tu vida en números…
const tz = profile.time_zone ?? 'Europe/Madrid';
const now = new Date();
const born = stored
  ? birthDay({
      chart: stored.chart,
      birthDate: stored.input.date,
      timeKnown: stored.input.timeKnown,
      timeZone: stored.input.timeZone,
      today: todayFor(now, tz),
      now,
    })
  : null;
const place = profile.birth_place ?? 'tu ciudad';
const bornAsk = born
  ? ask(
      `Nací un ${born.weekday.day} de ${born.season.name}, en ${born.moon.name.toLowerCase()}${born.daylight ? (born.daylight.isDay ? ', de día' : ', de noche') : ''}. ¿Qué dice eso de mí?`,
    )
  : '';
// Tu ficha cósmica: lo esencial en una línea, enlazado a cada sección.
const FICHA = ['sol', 'moon', 'ascendente', 'numeros', 'chino', 'maya', 'tarot'];
const ficha = sections
  .filter((s) => FICHA.includes(s.id) && !(s.id === 'ascendente' && !stored?.input.timeKnown))
  .map((s) => ({
    id: s.id,
    label:
      s.id === 'numeros'
        ? `Camino de vida ${s.numbers?.[0]?.n ?? ''}`
        : s.title.replace(/^Tu /, ''),
  }));
---

<AppShell
  title="El significado de tu carta"
  current="carta"
  kicker="Todo lo que dice tu nacimiento"
  intro="El cielo del día que naciste, tu carta, tus números, tu nombre, tu animal chino, tu sello maya y tu carta del tarot, explicados por ZODI. ¿Quieres saber más de algo? Pregúntale."
>
  <nav class="crumbs" aria-label="Migas de pan">
    <a href="/app/carta">Tu carta</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Significado</span>
  </nav>

  {!sections.length ? (
    <EmptyState title="Todavía no hay carta" headingLevel={2}>
      <p>Danos tu fecha, hora y lugar de nacimiento y te cuento todo lo que dicen de ti.</p>
      <Button href="/app/onboarding">Completar mis datos</Button>
    </EmptyState>
  ) : (
    <>
      {born && (
        <BirthDayPanel
          b={born}
          place={place}
          timeKnown={stored!.input.timeKnown}
          timeZone={tz}
          birthDate={stored!.input.date}
          ask={bornAsk}
        />
      )}

      <section class="ficha" aria-labelledby="ficha-t">
        <h2 id="ficha-t">Tu ficha cósmica</h2>
        <ul>
          {ficha.map((f) => (
            <li>
              <a href={`#${f.id}`}>{f.label}</a>
            </li>
          ))}
        </ul>
      </section>

      <nav class="toc" aria-label="Índice">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="badge">
            {s.kicker}
          </a>
        ))}
      </nav>

      <div class="sections">
        {sections.map((s) => (
          <section id={s.id} class="sec card" aria-labelledby={`${s.id}-t`}>
            <img
              class="sec-art"
              src={s.image}
              alt=""
              width="640"
              height="640"
              loading="lazy"
              decoding="async"
            />
            <div class="sec-text">
              <p class="kicker">{s.kicker}</p>
              <h2 id={`${s.id}-t`}>{s.title}</h2>
              {s.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
              {s.id === 'nombre' && (
                <>
                  <p>
                    Los nombres y apellidos también cuentan una historia: de dónde venía tu familia,
                    a qué se dedicaba o cómo la llamaban. ZODI conoce {fmt(REGISTRY_SIZE.nombres)}{' '}
                    nombres y {fmt(REGISTRY_SIZE.apellidos)} apellidos, y si el tuyo no está, lo
                    investiga al momento.
                  </p>
                  <ul class="name-parts">
                    {nameParts.map((part) => (
                      <li>
                        <p class="name-word">
                          <strong>{part.word}</strong>
                          <span class="muted">
                            {' '}
                            · {part.kind}
                            {part.entry && <> · {part.entry.origin}</>}
                          </span>
                        </p>
                        {part.entry ? (
                          <>
                            <p>
                              <strong>{cap(part.entry.meaning)}.</strong>
                            </p>
                            {part.entry.detail && <p>{part.entry.detail}</p>}
                            {part.entry.note && <p class="muted">{part.entry.note}</p>}
                          </>
                        ) : (
                          <NameLookup client:visible word={part.word} kind={part.kind} />
                        )}
                      </li>
                    ))}
                  </ul>
                  {needsSurnames && (
                    <p class="name-nudge">
                      Solo tengo tu nombre de pila. Escribe también tus <strong>apellidos</strong> y
                      te cuento la historia de cada uno.
                    </p>
                  )}
                  {savedName && (
                    <p class="name-saved">Guardado: ZODI ya se acuerda de tu nombre completo.</p>
                  )}
                  <form method="post" action="/app/carta/significado#nombre" class="name-form">
                    <Field
                      name="nombre"
                      label="Tu nombre completo"
                      hint="Como en tu carnet, con los dos apellidos. ZODI lo guarda para recordarlo; también afina tus números."
                      value={fullName}
                      maxlength="80"
                      autocomplete="name"
                    />
                    <Button type="submit" variant="secondary" size="sm">
                      Ver lo que significa
                    </Button>
                  </form>
                </>
              )}
              {s.facts && (
                <dl class="facts">
                  {s.facts.map((f) => (
                    <div>
                      <dt>{f.label}</dt>
                      <dd>
                        {f.text}
                        {f.href && (
                          <>
                            {' '}
                            <a class="fact-link" href={f.href}>
                              Ver la pareja completa
                            </a>
                          </>
                        )}
                      </dd>
                    </div>
                  ))}
                </dl>
              )}
              {s.numbers && (
                <ul class="numbers">
                  {s.numbers.map((n) => (
                    <li>
                      <img
                        src={numberImage(n.n)}
                        alt=""
                        width="480"
                        height="480"
                        loading="lazy"
                        decoding="async"
                      />
                      <span>
                        <span class="num-label">{n.label}</span>
                        <strong class="num-value">{n.n}</strong>
                        <span class="muted">{n.text}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              )}
              <a class="ask" href={ask(s.ask)}>
                <Icon name="chat" size={16} /> Pregúntale a ZODI sobre esto
              </a>
            </div>
          </section>
        ))}
      </div>

      <section class="more card" aria-labelledby="mas">
        <img
          src="/art/zodi-bola-640.webp"
          alt=""
          width="640"
          height="640"
          loading="lazy"
          decoding="async"
        />
        <div>
          <h2 id="mas">¿Quieres que te lo cuente ZODI, con todo junto?</h2>
          <p class="muted">
            La lectura con IA cruza todos estos datos entre sí y con el cielo de hoy, en el tono que
            elijas.
          </p>
          <div class="more-actions">
            <Button href="/app/lecturas/carta-natal" icon="sparkles">
              Interpretar mi carta con IA
            </Button>
            <form method="post" action="/app/yo/informe" class="pdf-form">
              <input type="hidden" name="nombre" value={fullName} />
              <Button type="submit" variant="secondary">
                Descargar todo en PDF
              </Button>
            </form>
          </div>
        </div>
      </section>
    </>
  )}
</AppShell>

<style>
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .crumbs a {
    color: var(--acid);
  }
  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }
  .toc a {
    min-height: 32px;
    text-decoration: none;
  }
  /* En el móvil, una sola fila que se desliza: el contenido se ve antes. */
  @media (max-width: 719px) {
    .toc {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--space-4));
      padding: 0 var(--space-4) var(--space-2);
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }
    .toc a {
      flex: none;
      scroll-snap-align: start;
    }
  }
  .toc a:hover {
    border-color: var(--acid);
    color: var(--acid-soft);
  }
  .sections {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    max-width: 58rem;
  }
  .sec {
    display: grid;
    gap: var(--space-4);
    scroll-margin-top: var(--space-6);
  }
  @media (min-width: 720px) {
    .sec {
      grid-template-columns: 9rem minmax(0, 1fr);
      align-items: start;
    }
  }
  .sec-art {
    width: 9rem;
    height: 9rem;
    border-radius: var(--radius-lg);
    object-fit: cover;
    border: 1px solid var(--line-acid);
  }
  .sec-text {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }
  .sec-text h2 {
    margin: 0;
    font-size: var(--step-2);
  }
  .sec-text p {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .numbers {
    list-style: none;
    margin: var(--space-2) 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  .numbers li {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-violet);
    background: rgb(155 77 255 / 8%);
  }
  .numbers img {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-md);
    object-fit: cover;
  }
  .numbers li > span {
    display: grid;
    gap: 2px;
    font-size: var(--step--1);
  }
  .num-label {
    color: var(--acid);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .num-value {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1;
  }
  .ask {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-4);
    border-radius: var(--radius-full);
    border: 1px solid var(--line-acid);
    color: var(--acid);
    font-weight: 700;
    text-decoration: none;
  }
  .ask:hover {
    background: rgb(184 255 23 / 10%);
  }
  .more {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-4);
    align-items: center;
    max-width: 58rem;
  }
  @media (min-width: 720px) {
    .more {
      grid-template-columns: 9rem minmax(0, 1fr);
    }
  }
  .more img {
    width: 9rem;
    height: 9rem;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--acid);
  }
  .more h2 {
    font-size: var(--step-2);
    margin: 0 0 var(--space-2);
  }
  .more-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .name-parts {
    list-style: none;
    margin: var(--space-2) 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .name-parts li {
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-violet);
    background: rgb(155 77 255 / 8%);
    display: grid;
    gap: var(--space-1);
  }
  .name-word strong {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ink);
  }
  .name-form {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    margin-top: var(--space-2);
  }
  .name-form :global(.field) {
    width: 100%;
  }
  .pdf-form {
    display: contents;
  }
  .ficha {
    margin-bottom: var(--space-4);
    max-width: 58rem;
  }
  .ficha h2 {
    font-size: var(--step-1);
    margin: 0 0 var(--space-2);
  }
  .ficha ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .ficha a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, rgb(155 77 255 / 30%), rgb(184 255 23 / 14%));
    border: 1px solid var(--line-acid);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .ficha a:hover {
    color: var(--acid);
  }
  .name-parts :global(.name-loading) {
    color: var(--acid);
  }
  .name-parts :global(.name-spark) {
    display: inline-block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .name-parts :global(.name-spark) {
      animation: spin 1.6s linear infinite;
    }
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .name-parts :global(.name-new) {
    font-size: 0.75rem;
    color: var(--acid);
    letter-spacing: 0.04em;
  }
  .name-nudge {
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    border: 1px dashed var(--acid);
    color: var(--ink);
  }
  .name-saved {
    color: var(--acid);
    font-weight: 700;
  }
  .facts {
    margin: var(--space-2) 0;
    display: grid;
    gap: var(--space-2);
  }
  .facts > div {
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 3%);
    display: grid;
    gap: 2px;
  }
  .facts dt {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--acid);
    font-weight: 700;
  }
  .facts dd {
    margin: 0;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .fact-link {
    color: var(--acid);
    font-weight: 700;
  }
</style>
