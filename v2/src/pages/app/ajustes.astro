---
import AppShell from '@/layouts/AppShell.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import ErrorSummary from '@/components/ui/ErrorSummary.astro';
import Field from '@/components/ui/Field.astro';
import { formatPosition } from '@/lib/astro-engine/labels';
import { NOTIFICATIONS, TONES, TOPICS } from '@/lib/onboarding/steps';
import { getLatestSelfChart } from '@/lib/server/charts';
import { UsernameTakenError, updateOwnProfile } from '@/lib/server/profile';
import { READING_TONES } from '@/lib/supabase/enums';
import { fieldErrors, formToObject } from '@/lib/validation/common';
import { readingDate } from '@/lib/readings/format';
import { trialDaysLeft } from '@/lib/server/quota';
import { RELATIONSHIP_OPTIONS, settingsSchema, SETTINGS_ARRAYS } from '@/lib/validation/settings';

const { supabase, user } = Astro.locals;
let profile = Astro.locals.profile;
if (!supabase || !user || !profile) return Astro.redirect('/auth/login', 303);

let errors: Record<string, string> = {};
let raw: Record<string, unknown> = {};

if (Astro.request.method === 'POST') {
  raw = formToObject(await Astro.request.formData(), SETTINGS_ARRAYS);
  const parsed = settingsSchema.safeParse(raw);
  if (!parsed.success) {
    errors = fieldErrors(parsed.error);
  } else {
    try {
      profile = await updateOwnProfile(supabase, user.id, parsed.data);
      return Astro.redirect('/app/ajustes?guardado=1', 303);
    } catch (error) {
      if (error instanceof UsernameTakenError)
        errors = { username: 'Ese usuario ya tiene dueño. Prueba otro.' };
      else {
        console.error('[ajustes]', error);
        errors = { _form: 'No hemos podido guardar. Inténtalo de nuevo.' };
      }
    }
  }
  Astro.response.status = 422;
}

const stored = await getLatestSelfChart(supabase);
const v = (key: string, saved: unknown) => String(raw[key] ?? saved ?? '');
const topics = (raw.favorite_topics as string[] | undefined) ?? profile.favorite_topics;
const notifs = (raw.notification_prefs as string[] | undefined) ?? profile.notification_prefs;
const tone = String(raw.reading_tone ?? profile.reading_tone);
const saved = Astro.url.searchParams.get('guardado') === '1';
const passwordChanged = Astro.url.searchParams.get('clave') === '1';
const relationship = String(raw.relationship_status ?? profile.relationship_status ?? '');
const hasKids = String(
  raw.has_kids ?? (profile.has_kids === true ? 'si' : profile.has_kids === false ? 'no' : ''),
);
const trialDays = trialDaysLeft(profile.trial_ends_at);
const birthDate = profile.birth_date
  ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'long', timeZone: 'UTC' }).format(
      new Date(`${profile.birth_date}T12:00:00Z`),
    )
  : '—';
const planLabel = { free: 'Gratis', premium: 'Premium', vip: 'VIP' }[profile.plan];
---

<AppShell
  title="Ajustes"
  current="ajustes"
  kicker="Tu cuenta"
  intro="Cómo te llamamos, lo que ZODI sabe de ti y cómo te habla. Todo se puede cambiar cuando quieras."
  toast={
    saved
      ? { message: 'Guardado. ZODI toma nota.' }
      : passwordChanged
        ? { message: 'Contraseña cambiada.' }
        : undefined
  }
>
  <div class="layout">
    <form method="post" class="stack" novalidate data-settings>
      <ErrorSummary errors={errors} />
      <Card title="Tú" kicker="Perfil">
        <Field
          name="display_name"
          label="Nombre visible"
          autocomplete="given-name"
          value={v('display_name', profile.display_name)}
          required
          error={errors.display_name}
        />
        <Field
          name="username"
          label="Nombre de usuario"
          autocomplete="username"
          spellcheck="false"
          hint="De 3 a 24 caracteres: letras sin tildes, números o guion bajo."
          value={v('username', profile.username)}
          required
          error={errors.username}
        />
      </Card>

      <section id="sobre-ti" class="anchor">
        <Card title="Sobre ti" kicker="Opcional">
          <p class="muted">
            Lo usa solo ZODI para que tus lecturas hablen de tu vida real (no se enseña a nadie).
            Deja en blanco lo que no quieras contar.
          </p>
          <div class="field">
            <label class="field-label" for="f-relationship_status">
              Situación sentimental
            </label>
            <p
              id="f-relationship_status-error"
              class="field-error"
              data-error-for="relationship_status"
              hidden={!errors.relationship_status}
            >
              {errors.relationship_status}
            </p>
            <select id="f-relationship_status" name="relationship_status" class="select">
              <option value="" selected={relationship === ''}>
                Prefiero no decirlo
              </option>
              {RELATIONSHIP_OPTIONS.map((o) => (
                <option value={o.value} selected={relationship === o.value}>
                  {o.label}
                </option>
              ))}
            </select>
          </div>
          <Field
            name="partner_name"
            label="Nombre de tu pareja o de quien te quita el sueño"
            hint="Opcional. ZODI lo usará en las lecturas de amor."
            autocomplete="off"
            maxlength={60}
            value={v('partner_name', profile.partner_name)}
            error={errors.partner_name}
          />
          <fieldset class="group">
            <legend>¿Tienes hijos?</legend>
            <div class="chip-group">
              <label class="chip">
                <input type="radio" name="has_kids" value="si" checked={hasKids === 'si'} />
                Sí
              </label>
              <label class="chip">
                <input type="radio" name="has_kids" value="no" checked={hasKids === 'no'} />
                No
              </label>
              <label class="chip">
                <input type="radio" name="has_kids" value="" checked={hasKids === ''} />
                Prefiero no decirlo
              </label>
            </div>
          </fieldset>
          <Field
            name="kids_count"
            label="¿Cuántos?"
            type="number"
            inputmode="numeric"
            min="0"
            max="20"
            hint="Solo si has dicho que sí."
            value={v('kids_count', profile.kids_count)}
            error={errors.kids_count}
          />
          <div class="field">
            <label class="field-label" for="f-personal_bio">
              Cuéntale a ZODI de ti
            </label>
            <p id="f-personal_bio-hint" class="field-hint">
              A qué te dedicas, qué te preocupa ahora, qué quieres conseguir. Máximo 500 caracteres.
            </p>
            <p
              id="f-personal_bio-error"
              class="field-error"
              data-error-for="personal_bio"
              hidden={!errors.personal_bio}
            >
              {errors.personal_bio}
            </p>
            <textarea
              id="f-personal_bio"
              name="personal_bio"
              class="input"
              rows="4"
              maxlength="500"
              aria-describedby="f-personal_bio-hint"
              placeholder="Trabajo en diseño, acabo de mudarme y estoy pensando en cambiar de trabajo."
            >{v('personal_bio', profile.personal_bio)}</textarea>
          </div>
        </Card>
      </section>

      <Card title="Tu Zodi" kicker="Lecturas">
        <fieldset class="group anchor" id="tono">
          <legend>Tono</legend>
          <p class="field-hint">Así te habla ZODI en las lecturas y en el oráculo.</p>
          <div class="choice-grid">
            {READING_TONES.map((t, i) => (
              <label class="choice">
                <input
                  type="radio"
                  name="reading_tone"
                  value={t}
                  checked={tone === t}
                  id={i === 0 ? 'f-reading_tone' : undefined}
                />
                <span class="choice-title">{TONES[t].title}</span>
                <small>{TONES[t].hint}</small>
                <em class="tone-example">“{TONES[t].example}”</em>
              </label>
            ))}
          </div>
          <p
            id="f-reading_tone-error"
            class="field-error"
            data-error-for="reading_tone"
            hidden={!errors.reading_tone}
          >
            {errors.reading_tone}
          </p>
        </fieldset>
        <fieldset class="group">
          <legend>Temas (hasta 4)</legend>
          <div class="chip-group">
            {TOPICS.map((t, i) => (
              <label class="chip">
                <input
                  type="checkbox"
                  name="favorite_topics"
                  value={t.value}
                  checked={topics.includes(t.value)}
                  id={i === 0 ? 'f-favorite_topics' : undefined}
                />
                {t.label}
              </label>
            ))}
          </div>
          <p
            id="f-favorite_topics-error"
            class="field-error"
            data-error-for="favorite_topics"
            hidden={!errors.favorite_topics}
          >
            {errors.favorite_topics}
          </p>
        </fieldset>
      </Card>

      <Card title="Avisos" kicker="Muy pronto">
        <p class="muted">
          Todavía no enviamos avisos. Marca los que te interesan y te llegarán en cuanto estén
          listos.
        </p>
        <div class="choice-grid">
          {NOTIFICATIONS.map((n, i) => (
            <label class="choice">
              <input
                type="checkbox"
                name="notification_prefs"
                value={n.value}
                checked={notifs.includes(n.value)}
                id={i === 0 ? 'f-notification_prefs' : undefined}
              />
              <span class="choice-title">{n.label}</span>
              <small>{n.hint}</small>
            </label>
          ))}
        </div>
      </Card>

      <div class="save">
        <Button type="submit" icon="check">
          Guardar cambios
        </Button>
      </div>
    </form>

    <div class="side">
      <Card title="Tu cuenta" kicker={planLabel}>
        <dl class="facts">
          <div>
            <dt>Correo</dt>
            <dd class="break">{user.email ?? '—'}</dd>
          </div>
          <div>
            <dt>Plan</dt>
            <dd>
              {trialDays > 0
                ? `Todo gratis ${trialDays === 1 ? '1 día más' : `${trialDays} días más`}`
                : planLabel}
            </dd>
          </div>
          {profile.trial_ends_at && trialDays > 0 && (
            <div>
              <dt>Hasta el</dt>
              <dd>{readingDate(profile.trial_ends_at, profile.time_zone ?? 'Europe/Madrid')}</dd>
            </div>
          )}
        </dl>
        <div class="account-actions">
          <Button href="/auth/nueva-clave?desde=ajustes" variant="secondary">
            Cambiar contraseña
          </Button>
        </div>
        {profile.is_moderator && (
          <p class="small">
            <a href="/app/moderacion" class="mod-link">
              Moderación de la comunidad
            </a>
          </p>
        )}
        <p class="muted small">
          <a href="/app/cuenta/borrar" class="danger-link">
            Borrar mi cuenta y mis datos
          </a>
        </p>
      </Card>

      <Card title="Nacimiento" kicker="Datos de tu carta" class="birth">
        <dl class="facts">
          <div>
            <dt>Fecha</dt>
            <dd>{birthDate}</dd>
          </div>
          <div>
            <dt>Hora</dt>
            <dd>{profile.birth_time_known ? profile.birth_time?.slice(0, 5) : 'Desconocida'}</dd>
          </div>
          <div>
            <dt>Lugar</dt>
            <dd>{profile.birth_place ?? '—'}</dd>
          </div>
          <div>
            <dt>Zona horaria</dt>
            <dd>{profile.time_zone?.replace('_', ' ') ?? '—'}</dd>
          </div>
          {stored && (
            <div>
              <dt>Sol</dt>
              <dd>{formatPosition(stored.chart.planets[0]!)}</dd>
            </div>
          )}
        </dl>
        <p class="muted">
          ¿Has encontrado tu hora exacta de nacimiento? Cámbiala aquí y recalculamos tu carta (y tu
          Ascendente) desde cero.
        </p>
        <Button href="/app/onboarding?paso=nacimiento" variant="secondary">
          Cambiar datos de nacimiento
        </Button>
      </Card>

      <div data-motion-card hidden>
        <Card title="Movimiento" kicker="Accesibilidad">
          <div class="check">
            <input
              id="motion-switch"
              class="switch"
              type="checkbox"
              role="switch"
              aria-describedby="motion-hint"
            />
            <label for="motion-switch">Reducir animaciones</label>
          </div>
          <p id="motion-hint" class="field-hint">
            Quita transiciones, scroll suave, confeti y efectos del ratón en este dispositivo.
          </p>
        </Card>
      </div>
    </div>
  </div>
</AppShell>

<script>
  import { toast } from '@/components/ui/toast';
  import { setPreference, storedPreference } from '@/lib/motion';
  import { stopSmoothScroll } from '@/lib/motion/client';
  import { enhanceForm } from '@/lib/forms/enhance';

  // Preferencia local de movimiento. Sin JS no sirve, por eso la tarjeta sale oculta.
  const card = document.querySelector<HTMLElement>('[data-motion-card]');
  const sw = document.querySelector<HTMLInputElement>('#motion-switch');
  if (card && sw) {
    card.hidden = false;
    const hint = document.querySelector<HTMLElement>('#motion-hint');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      sw.checked = true;
      sw.disabled = true;
      if (hint) hint.textContent = 'Tu sistema ya pide menos movimiento: Zodi lo respeta siempre.';
    } else {
      sw.checked = storedPreference() === 'reduce';
      sw.addEventListener('change', () => {
        setPreference(sw.checked ? 'reduce' : 'full');
        if (sw.checked) stopSmoothScroll();
        toast(sw.checked ? 'Animaciones reducidas.' : 'Animaciones activadas.');
      });
    }
  }
  import { SETTINGS_ARRAYS, settingsSchema } from '@/lib/validation/settings';

  enhanceForm(document.querySelector<HTMLFormElement>('form[data-settings]'), settingsSchema, {
    arrays: SETTINGS_ARRAYS,
  });
</script>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  @media (max-width: 1099px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .side {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    min-width: 0;
  }
  .save {
    display: flex;
    justify-content: flex-end;
  }
  .facts {
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    color: var(--ink-soft);
  }
  .facts dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }
  .break {
    overflow-wrap: anywhere;
  }
  .anchor {
    scroll-margin-top: var(--space-6);
  }
  .tone-example {
    font-size: var(--step--1);
    color: var(--acid-soft);
  }
  .account-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .small {
    font-size: var(--step--1);
  }
  .danger-link {
    color: #ff8fa3;
  }
  .mod-link {
    color: var(--acid);
    font-weight: 700;
  }
</style>
