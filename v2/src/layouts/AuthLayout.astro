---
/** Pantallas de acceso y onboarding: logo Zodi, panel de cristal centrado. */
import Base from './Base.astro';

interface Props {
  title: string;
  kicker?: string | undefined;
  intro?: string | undefined;
  wide?: boolean;
}
const { title, kicker, intro, wide = false } = Astro.props;
---

<Base title={title}>
  <main id="main" class="auth">
    <a class="brand" href="/">
      <img src="/brand/logo-240.webp" alt="ZODI, ir al inicio" width="240" height="160" />
    </a>
    <section class:list={['panel', { wide }]} aria-labelledby="auth-title">
      <div class="head">
        {kicker && <p class="kicker">{kicker}</p>}
        <h1 id="auth-title" class="vt-title">
          {title}
        </h1>
        {intro && <p class="intro">{intro}</p>}
      </div>
      <slot />
    </section>
    <slot name="after" />
  </main>
</Base>

<style>
  .auth {
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-4) var(--space-7);
  }
  .brand img {
    width: 160px;
    height: auto;
    display: block;
    filter: drop-shadow(0 0 18px rgb(184 255 23 / 25%));
  }
  .panel {
    width: min(100%, 30rem);
    background: var(--panel);
    border: 1px solid var(--line-acid);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg), var(--glow-acid);
    padding: clamp(1.25rem, 4vw, 2.25rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
  }
  .panel.wide {
    width: min(100%, 44rem);
  }
  .head {
    display: grid;
    gap: var(--space-2);
  }
  h1 {
    font-size: var(--step-4);
  }
  .intro {
    color: var(--ink-soft);
  }
</style>
