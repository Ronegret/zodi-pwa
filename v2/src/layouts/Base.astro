---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Zodi — astrología personal con IA' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Zodi</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <slot />
  </body>
</html>
