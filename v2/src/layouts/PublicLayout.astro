---
/** Páginas públicas (sin cuenta): cabecera con accesos y pie con los signos. */
import Base from './Base.astro';
import Button from '@/components/ui/Button.astro';
import SiteFooter from '@/components/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const { title, description, canonical, image } = Astro.props;
---

<Base
  title={title}
  {...(description ? { description } : {})}
  {...(canonical ? { canonical } : {})}
  {...(image ? { image } : {})}
>
  <header class="pub-top">
    <a href="/" class="pub-logo" aria-label="ZODI, ir a la portada">
      <img src="/brand/logo-240.webp" alt="" width="240" height="160" />
    </a>
    <nav aria-label="Principal" class="pub-nav">
      <a href="/horoscopo" class="pub-link">
        Horóscopos
      </a>
      <Button href="/auth/login" variant="ghost" size="sm">
        Entrar
      </Button>
      <Button href="/auth/registro" size="sm">
        Crear cuenta
      </Button>
    </nav>
  </header>
  <main id="main" class="pub-main">
    <slot />
  </main>
  <SiteFooter variant="full" />
</Base>

<style>
  .pub-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) clamp(1rem, 4vw, 3rem);
  }
  .pub-logo img {
    width: 110px;
    height: auto;
    display: block;
    filter: drop-shadow(0 0 16px rgb(184 255 23 / 25%));
  }
  .pub-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .pub-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-3);
    color: var(--ink);
    font-weight: 700;
  }
  .pub-link:hover {
    color: var(--acid);
  }
  .pub-main {
    max-width: 76rem;
    margin: 0 auto;
    padding: var(--space-4) clamp(1rem, 4vw, 3rem) var(--space-8);
  }
</style>
