# Copia a .env.local (ignorado por git). Nunca subas valores reales.

# Supabase (proyecto nuevo, limpio). Settings → API.
# URL pública del proyecto: https://<ref>.supabase.co
PUBLIC_SUPABASE_URL=
# Clave anon o publishable (sb_publishable_…): va al navegador, la protege la RLS.
PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role o secret (sb_secret_…): SOLO servidor, salta la RLS.
SUPABASE_SERVICE_ROLE_KEY=

# IA (servidor)
ANTHROPIC_API_KEY=

# Los e2e (npm run test:e2e) no usan estas variables: arrancan un Supabase
# simulado en :54329 y lo pasan al servidor de desarrollo en :4329.
